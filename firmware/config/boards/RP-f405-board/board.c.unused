/**
 * @file boards/RP-f405-board/board.c
 *
 * Board-level early init and SDC/MMC card-detect callbacks.
 *
 * The WeAct STM32F405 Core Board V1.1 wires PA8 as TFCARD_PRESENT with an
 * on-board pull-up (card absent -> PA8 HIGH; card inserted -> PA8 LOW).
 * There is no write-protect pin -- the slot is always treated as writable.
 *
 * GPIO initial state is handled entirely by the VAL_GPIOx_* macros in
 * board.h (applied by the ChibiOS startup / HAL init sequence), so
 * __early_init() here is minimal.
 */

#include "hal.h"
#include "unused.h"

/*===========================================================================*/
/* Driver exported functions.                                                */
/*===========================================================================*/

/**
 * @brief   Early initialization code.
 * @details GPIO ports and system clocks are initialized before everything
 *          else.  No external SDRAM on this board.
 */
void __early_init(void) {
    /* Allow debug access in all low-power modes. */
    DBGMCU->CR |= DBGMCU_CR_DBG_SLEEP | DBGMCU_CR_DBG_STOP | DBGMCU_CR_DBG_STANDBY;

    stm32_gpio_init();
    stm32_clock_init();
}

/*---------------------------------------------------------------------------
 * SDC (SDIO) card-detect and write-protect callbacks.
 * Required when HAL_USE_SDC = TRUE.
 *---------------------------------------------------------------------------*/
#if HAL_USE_SDC || defined(__DOXYGEN__)

/**
 * @brief   SDC card detection.
 * @return  TRUE if a card is inserted (PA8 LOW), FALSE otherwise.
 *
 * PA8 = TFCARD_PRESENT on the WeAct board.
 * The board has a pull-up, so the pin reads LOW when a card is present.
 */
bool sdc_lld_is_card_inserted(SDCDriver *sdcp)
{
    UNUSED(sdcp);
    /* Active-low: PA8 pulled LOW by card, HIGH by on-board pull-up. */
    return (palReadPad(GPIOA, 8) == PAL_LOW);
}

/**
 * @brief   SDC card write protection detection.
 * @return  Always FALSE -- no write-protect pin on this slot.
 */
bool sdc_lld_is_write_protected(SDCDriver *sdcp)
{
    UNUSED(sdcp);
    return false;
}

#endif /* HAL_USE_SDC */

#if HAL_USE_MMC_SPI || defined(__DOXYGEN__)

/**
 * @brief   MMC_SPI card detection (not used -- SDIO mode only).
 */
bool mmc_lld_is_card_inserted(MMCDriver *mmcp)
{
    UNUSED(mmcp);
    return true;
}

/**
 * @brief   MMC_SPI write protection detection (not used).
 */
bool mmc_lld_is_write_protected(MMCDriver *mmcp)
{
    UNUSED(mmcp);
    return false;
}

#endif /* HAL_USE_MMC_SPI */
