/*
 * board.h - RP-f405-board
 * WeAct Studio STM32F405 Core Board V1.1 (LQFP64)
 *
 * GPIO initial state applied at reset by ChibiOS __early_init().
 * Every pin is explicitly defined — no inherited defaults.
 *
 * STM32F405RGT6 LQFP64 available GPIO:
 *   PA0–PA15, PB0–PB15, PC0–PC15, PD2 only.
 *   PH0/PH1 are OSC_IN/OSC_OUT — not GPIO-capable, not defined here.
 *   No PE, PF, PG, PI, PJ, PK on this package.
 *
 * Design rules applied:
 *   OUTPUTS  → OUTPUT mode, ODR=LOW (safe de-energised state at reset)
 *              Exceptions: USART TX (PA9) ODR=HIGH (idle mark)
 *   ANALOG   → ANALOG mode, no pull, speed irrelevant
 *   ALT FUNC → ALTERNATE mode, pull/speed per peripheral requirement
 *   INPUTS   → INPUT mode, PULLUP unless external pull is guaranteed
 *              PB2 (BOOT1/AC-req): PULLDOWN — conditioning board pulls LOW
 *              Trigger inputs (PC6/PC7): FLOATING — Schmitt trigger on board
 *              VSS/ABS (PB13/PB14): FLOATING — conditioned signal
 *   SWD      → PA13 PULLUP, PA14 PULLDOWN (ARM Cortex-M default)
 *   PA15     → INPUT PULLUP at reset (JTDI default); rusefi SWJ init
 *              will remap to TIM2_CH1 AF1 at runtime.
 *   OSC32    → INPUT FLOATING (PC14/PC15, crystal pins)
 *   USB FS   → ALTERNATE AF10, HIGH speed, floating (PA11/PA12)
 *   SDIO     → ALTERNATE AF12, HIGH speed, PULLUP (PC8–PC12, PD2)
 *   CAN1     → ALTERNATE AF9, HIGH speed (PB8/PB9)
 *   I2C1     → ALTERNATE AF4, OPEN-DRAIN, no pull (PB6/PB7)
 *              External pull-ups on conditioning board.
 *   USART1   → ALTERNATE AF7 (PA9 TX, PA10 RX)
 *   PC13     → OUTPUT LOW — fuel pump relay; 3 mA limit, use driver stage
 */

#ifndef BOARD_H
#define BOARD_H

/*===========================================================================*/
/* Board identifier.                                                         */
/*===========================================================================*/
#define BOARD_RP_F405
#define BOARD_NAME "RP-f405-board"

/*===========================================================================*/
/* USB / OSC settings.                                                       */
/*===========================================================================*/
#define EFI_USB_AF          10U
#define EFI_USB_SERIAL_DM   Gpio::A11
#define EFI_USB_SERIAL_DP   Gpio::A12

#if !defined(STM32_LSECLK)
#define STM32_LSECLK        32768U
#endif

#define STM32_VDD           330U

#ifndef STM32F405xx
#define STM32F405xx
#endif

/*===========================================================================*/
/* Pin symbolic names — positional index within port (0–15).                 */
/*===========================================================================*/

/* GPIOA */
#define GPIOA_MAP_AIN           0U   /* ADC1_IN0  - MAP sensor          */
#define GPIOA_TPS_AIN           1U   /* ADC1_IN1  - TPS                 */
#define GPIOA_KNOCK_AIN         2U   /* ADC1_IN2  - Knock integrator    */
#define GPIOA_COPOT_AIN         3U   /* ADC1_IN3  - CO-pot              */
#define GPIOA_IAT_AIN           4U   /* ADC1_IN4  - IAT NTC             */
#define GPIOA_CLT_AIN           5U   /* ADC1_IN5  - CLT NTC             */
#define GPIOA_O2_AIN            6U   /* ADC1_IN6  - Narrowband O2       */
#define GPIOA_AUX_AIN           7U   /* ADC1_IN7  - Auxiliary analog    */
#define GPIOA_TFCARD_PRESENT    8U   /* SD card detect (active-low)     */
#define GPIOA_USART1_TX         9U   /* USART1 TX  - TunerStudio        */
#define GPIOA_USART1_RX        10U   /* USART1 RX  - TunerStudio        */
#define GPIOA_USB_DM           11U   /* USB OTG FS D-                   */
#define GPIOA_USB_DP           12U   /* USB OTG FS D+                   */
#define GPIOA_SWDIO            13U   /* SWD data                        */
#define GPIOA_SWCLK            14U   /* SWD clock                       */
#define GPIOA_OBV_PWM          15U   /* TIM2_CH1 overboost valve (AF1 at runtime) */

/* GPIOB */
#define GPIOB_IAC_PWM           0U   /* TIM3_CH3 - Idle air control PWM */
#define GPIOB_AUX_PWM           1U   /* TIM3_CH4 - Auxiliary PWM        */
#define GPIOB_AC_REQ            2U   /* BOOT1 / A/C request (active-low)*/
#define GPIOB_EVAP_PWM          3U   /* TIM2_CH2 - EVAP purge PWM       */
#define GPIOB_AUX_SW1           4U   /* Auxiliary switch 1              */
#define GPIOB_MIL               5U   /* MIL warning lamp output         */
#define GPIOB_I2C1_SCL          6U   /* I2C1 SCL                        */
#define GPIOB_I2C1_SDA          7U   /* I2C1 SDA                        */
#define GPIOB_CAN1_RX           8U   /* CAN1 RX  (AF9)                  */
#define GPIOB_CAN1_TX           9U   /* CAN1 TX  (AF9)                  */
#define GPIOB_INJ1             10U   /* Injector 1 output               */
#define GPIOB_INJ2             11U   /* Injector 2 output               */
#define GPIOB_INJ4             12U   /* Injector 4 output               */
#define GPIOB_VSS              13U   /* Vehicle speed sensor input      */
#define GPIOB_ABS_IN           14U   /* ABS signal input                */
#define GPIOB_INJ3             15U   /* Injector 3 output               */

/* GPIOC */
#define GPIOC_VBATT_AIN         0U   /* ADC1_IN10 - Battery voltage     */
#define GPIOC_IGN1              1U   /* Ignition 1 output               */
#define GPIOC_IGN2              2U   /* Ignition 2 output               */
#define GPIOC_IGN3              3U   /* Ignition 3 output               */
#define GPIOC_IGN4              4U   /* Ignition 4 output               */
#define GPIOC_AUX_SW2           5U   /* Auxiliary switch 2              */
#define GPIOC_CRS               6U   /* Crank sensor input (EXTI)       */
#define GPIOC_CAS               7U   /* Cam sensor input (EXTI)         */
#define GPIOC_SDIO_D0           8U   /* SDIO D0  (AF12)                 */
#define GPIOC_SDIO_D1           9U   /* SDIO D1  (AF12)                 */
#define GPIOC_SDIO_D2          10U   /* SDIO D2  (AF12)                 */
#define GPIOC_SDIO_D3          11U   /* SDIO D3  (AF12)                 */
#define GPIOC_SDIO_CK          12U   /* SDIO CLK (AF12)                 */
#define GPIOC_FUEL_PUMP        13U   /* Fuel pump relay output          */
#define GPIOC_OSC32_IN         14U   /* RTC 32.768 kHz crystal IN       */
#define GPIOC_OSC32_OUT        15U   /* RTC 32.768 kHz crystal OUT      */

/* GPIOD — PD2 only on LQFP64 */
#define GPIOD_SDIO_CMD          2U   /* SDIO CMD (AF12)                 */

/*===========================================================================*/
/* PAL macros (same as f429 reference).                                      */
/*===========================================================================*/
#define PIN_MODE_INPUT(n)           (0U << ((n) * 2U))
#define PIN_MODE_OUTPUT(n)          (1U << ((n) * 2U))
#define PIN_MODE_ALTERNATE(n)       (2U << ((n) * 2U))
#define PIN_MODE_ANALOG(n)          (3U << ((n) * 2U))
#define PIN_ODR_LOW(n)              (0U << (n))
#define PIN_ODR_HIGH(n)             (1U << (n))
#define PIN_OTYPE_PUSHPULL(n)       (0U << (n))
#define PIN_OTYPE_OPENDRAIN(n)      (1U << (n))
#define PIN_OSPEED_VERYLOW(n)       (0U << ((n) * 2U))
#define PIN_OSPEED_LOW(n)           (1U << ((n) * 2U))
#define PIN_OSPEED_MEDIUM(n)        (2U << ((n) * 2U))
#define PIN_OSPEED_HIGH(n)          (3U << ((n) * 2U))
#define PIN_PUPDR_FLOATING(n)       (0U << ((n) * 2U))
#define PIN_PUPDR_PULLUP(n)         (1U << ((n) * 2U))
#define PIN_PUPDR_PULLDOWN(n)       (2U << ((n) * 2U))
#define PIN_AFIO_AF(n, v)           ((v) << (((n) % 8U) * 4U))

/*===========================================================================*/
/* GPIOA                                                                     */
/*                                                                           */
/* PA0–PA7  : ANALOG  (ADC inputs, op-amp buffered)                          */
/* PA8      : INPUT   PULLUP  (TFCARD_PRESENT active-low, board pull-up)     */
/* PA9      : ALT AF7 PULLUP  (USART1 TX — idle mark high)                   */
/* PA10     : ALT AF7 PULLUP  (USART1 RX)                                    */
/* PA11     : ALT AF10 HIGH   (USB OTG FS D-)                                */
/* PA12     : ALT AF10 HIGH   (USB OTG FS D+)                                */
/* PA13     : ALT AF0 PULLUP  (SWDIO)                                        */
/* PA14     : ALT AF0 PULLDOWN(SWCLK)                                        */
/* PA15     : INPUT PULLUP    (JTDI default; TIM2_CH1 AF1 after SWJ remap)  */
/*===========================================================================*/
#define VAL_GPIOA_MODER   (PIN_MODE_ANALOG(GPIOA_MAP_AIN)        | \
                           PIN_MODE_ANALOG(GPIOA_TPS_AIN)        | \
                           PIN_MODE_ANALOG(GPIOA_KNOCK_AIN)      | \
                           PIN_MODE_ANALOG(GPIOA_COPOT_AIN)      | \
                           PIN_MODE_ANALOG(GPIOA_IAT_AIN)        | \
                           PIN_MODE_ANALOG(GPIOA_CLT_AIN)        | \
                           PIN_MODE_ANALOG(GPIOA_O2_AIN)         | \
                           PIN_MODE_ANALOG(GPIOA_AUX_AIN)        | \
                           PIN_MODE_INPUT(GPIOA_TFCARD_PRESENT)  | \
                           PIN_MODE_ALTERNATE(GPIOA_USART1_TX)   | \
                           PIN_MODE_ALTERNATE(GPIOA_USART1_RX)   | \
                           PIN_MODE_ALTERNATE(GPIOA_USB_DM)      | \
                           PIN_MODE_ALTERNATE(GPIOA_USB_DP)      | \
                           PIN_MODE_ALTERNATE(GPIOA_SWDIO)       | \
                           PIN_MODE_ALTERNATE(GPIOA_SWCLK)       | \
                           PIN_MODE_INPUT(GPIOA_OBV_PWM))

#define VAL_GPIOA_OTYPER  (PIN_OTYPE_PUSHPULL(GPIOA_MAP_AIN)        | \
                           PIN_OTYPE_PUSHPULL(GPIOA_TPS_AIN)        | \
                           PIN_OTYPE_PUSHPULL(GPIOA_KNOCK_AIN)      | \
                           PIN_OTYPE_PUSHPULL(GPIOA_COPOT_AIN)      | \
                           PIN_OTYPE_PUSHPULL(GPIOA_IAT_AIN)        | \
                           PIN_OTYPE_PUSHPULL(GPIOA_CLT_AIN)        | \
                           PIN_OTYPE_PUSHPULL(GPIOA_O2_AIN)         | \
                           PIN_OTYPE_PUSHPULL(GPIOA_AUX_AIN)        | \
                           PIN_OTYPE_PUSHPULL(GPIOA_TFCARD_PRESENT)  | \
                           PIN_OTYPE_PUSHPULL(GPIOA_USART1_TX)      | \
                           PIN_OTYPE_PUSHPULL(GPIOA_USART1_RX)      | \
                           PIN_OTYPE_PUSHPULL(GPIOA_USB_DM)         | \
                           PIN_OTYPE_PUSHPULL(GPIOA_USB_DP)         | \
                           PIN_OTYPE_PUSHPULL(GPIOA_SWDIO)          | \
                           PIN_OTYPE_PUSHPULL(GPIOA_SWCLK)          | \
                           PIN_OTYPE_PUSHPULL(GPIOA_OBV_PWM))

#define VAL_GPIOA_OSPEEDR (PIN_OSPEED_VERYLOW(GPIOA_MAP_AIN)        | \
                           PIN_OSPEED_VERYLOW(GPIOA_TPS_AIN)        | \
                           PIN_OSPEED_VERYLOW(GPIOA_KNOCK_AIN)      | \
                           PIN_OSPEED_VERYLOW(GPIOA_COPOT_AIN)      | \
                           PIN_OSPEED_VERYLOW(GPIOA_IAT_AIN)        | \
                           PIN_OSPEED_VERYLOW(GPIOA_CLT_AIN)        | \
                           PIN_OSPEED_VERYLOW(GPIOA_O2_AIN)         | \
                           PIN_OSPEED_VERYLOW(GPIOA_AUX_AIN)        | \
                           PIN_OSPEED_VERYLOW(GPIOA_TFCARD_PRESENT)  | \
                           PIN_OSPEED_VERYLOW(GPIOA_USART1_TX)      | \
                           PIN_OSPEED_VERYLOW(GPIOA_USART1_RX)      | \
                           PIN_OSPEED_HIGH(GPIOA_USB_DM)            | \
                           PIN_OSPEED_HIGH(GPIOA_USB_DP)            | \
                           PIN_OSPEED_HIGH(GPIOA_SWDIO)             | \
                           PIN_OSPEED_HIGH(GPIOA_SWCLK)             | \
                           PIN_OSPEED_VERYLOW(GPIOA_OBV_PWM))

#define VAL_GPIOA_PUPDR   (PIN_PUPDR_FLOATING(GPIOA_MAP_AIN)        | \
                           PIN_PUPDR_FLOATING(GPIOA_TPS_AIN)        | \
                           PIN_PUPDR_FLOATING(GPIOA_KNOCK_AIN)      | \
                           PIN_PUPDR_FLOATING(GPIOA_COPOT_AIN)      | \
                           PIN_PUPDR_FLOATING(GPIOA_IAT_AIN)        | \
                           PIN_PUPDR_FLOATING(GPIOA_CLT_AIN)        | \
                           PIN_PUPDR_FLOATING(GPIOA_O2_AIN)         | \
                           PIN_PUPDR_FLOATING(GPIOA_AUX_AIN)        | \
                           PIN_PUPDR_PULLUP(GPIOA_TFCARD_PRESENT)   | \
                           PIN_PUPDR_PULLUP(GPIOA_USART1_TX)        | \
                           PIN_PUPDR_PULLUP(GPIOA_USART1_RX)        | \
                           PIN_PUPDR_FLOATING(GPIOA_USB_DM)         | \
                           PIN_PUPDR_FLOATING(GPIOA_USB_DP)         | \
                           PIN_PUPDR_PULLUP(GPIOA_SWDIO)            | \
                           PIN_PUPDR_PULLDOWN(GPIOA_SWCLK)          | \
                           PIN_PUPDR_PULLUP(GPIOA_OBV_PWM))

#define VAL_GPIOA_ODR     (PIN_ODR_LOW(GPIOA_MAP_AIN)               | \
                           PIN_ODR_LOW(GPIOA_TPS_AIN)               | \
                           PIN_ODR_LOW(GPIOA_KNOCK_AIN)             | \
                           PIN_ODR_LOW(GPIOA_COPOT_AIN)             | \
                           PIN_ODR_LOW(GPIOA_IAT_AIN)               | \
                           PIN_ODR_LOW(GPIOA_CLT_AIN)               | \
                           PIN_ODR_LOW(GPIOA_O2_AIN)                | \
                           PIN_ODR_LOW(GPIOA_AUX_AIN)               | \
                           PIN_ODR_HIGH(GPIOA_TFCARD_PRESENT)        | \
                           PIN_ODR_HIGH(GPIOA_USART1_TX)            | \
                           PIN_ODR_HIGH(GPIOA_USART1_RX)            | \
                           PIN_ODR_HIGH(GPIOA_USB_DM)               | \
                           PIN_ODR_HIGH(GPIOA_USB_DP)               | \
                           PIN_ODR_HIGH(GPIOA_SWDIO)                | \
                           PIN_ODR_HIGH(GPIOA_SWCLK)                | \
                           PIN_ODR_HIGH(GPIOA_OBV_PWM))

#define VAL_GPIOA_AFRL    (PIN_AFIO_AF(GPIOA_MAP_AIN,    0U)        | \
                           PIN_AFIO_AF(GPIOA_TPS_AIN,    0U)        | \
                           PIN_AFIO_AF(GPIOA_KNOCK_AIN,  0U)        | \
                           PIN_AFIO_AF(GPIOA_COPOT_AIN,  0U)        | \
                           PIN_AFIO_AF(GPIOA_IAT_AIN,    0U)        | \
                           PIN_AFIO_AF(GPIOA_CLT_AIN,    0U)        | \
                           PIN_AFIO_AF(GPIOA_O2_AIN,     0U)        | \
                           PIN_AFIO_AF(GPIOA_AUX_AIN,    0U))

#define VAL_GPIOA_AFRH    (PIN_AFIO_AF(GPIOA_TFCARD_PRESENT, 0U)   | \
                           PIN_AFIO_AF(GPIOA_USART1_TX,  7U)        | \
                           PIN_AFIO_AF(GPIOA_USART1_RX,  7U)        | \
                           PIN_AFIO_AF(GPIOA_USB_DM,    10U)        | \
                           PIN_AFIO_AF(GPIOA_USB_DP,    10U)        | \
                           PIN_AFIO_AF(GPIOA_SWDIO,      0U)        | \
                           PIN_AFIO_AF(GPIOA_SWCLK,      0U)        | \
                           PIN_AFIO_AF(GPIOA_OBV_PWM,    0U))

/*===========================================================================*/
/* GPIOB                                                                     */
/*                                                                           */
/* PB0  : OUTPUT LOW  (IAC PWM — low-side off at reset)                      */
/* PB1  : OUTPUT LOW  (AUX PWM — low-side off at reset)                      */
/* PB2  : INPUT PULLDOWN (BOOT1 / AC-req; conditioning board pulls LOW)      */
/* PB3  : OUTPUT LOW  (EVAP PWM — low-side off at reset)                     */
/* PB4  : INPUT PULLUP (Aux switch 1)                                        */
/* PB5  : OUTPUT LOW  (MIL — off at reset)                                   */
/* PB6  : ALT AF4 OD  (I2C1 SCL — open-drain, ext pull-up on board)         */
/* PB7  : ALT AF4 OD  (I2C1 SDA — open-drain, ext pull-up on board)         */
/* PB8  : ALT AF9     (CAN1 RX)                                              */
/* PB9  : ALT AF9     (CAN1 TX)                                              */
/* PB10 : OUTPUT LOW  (INJ1 — off at reset)                                  */
/* PB11 : OUTPUT LOW  (INJ2 — off at reset)                                  */
/* PB12 : OUTPUT LOW  (INJ4 — off at reset)                                  */
/* PB13 : INPUT FLOATING (VSS — conditioned 3.3 V signal)                   */
/* PB14 : INPUT FLOATING (ABS — conditioned 3.3 V signal)                   */
/* PB15 : OUTPUT LOW  (INJ3 — off at reset)                                  */
/*===========================================================================*/
#define VAL_GPIOB_MODER   (PIN_MODE_OUTPUT(GPIOB_IAC_PWM)    | \
                           PIN_MODE_OUTPUT(GPIOB_AUX_PWM)    | \
                           PIN_MODE_INPUT(GPIOB_AC_REQ)       | \
                           PIN_MODE_OUTPUT(GPIOB_EVAP_PWM)   | \
                           PIN_MODE_INPUT(GPIOB_AUX_SW1)      | \
                           PIN_MODE_OUTPUT(GPIOB_MIL)         | \
                           PIN_MODE_ALTERNATE(GPIOB_I2C1_SCL) | \
                           PIN_MODE_ALTERNATE(GPIOB_I2C1_SDA) | \
                           PIN_MODE_ALTERNATE(GPIOB_CAN1_RX)  | \
                           PIN_MODE_ALTERNATE(GPIOB_CAN1_TX)  | \
                           PIN_MODE_OUTPUT(GPIOB_INJ1)        | \
                           PIN_MODE_OUTPUT(GPIOB_INJ2)        | \
                           PIN_MODE_OUTPUT(GPIOB_INJ4)        | \
                           PIN_MODE_INPUT(GPIOB_VSS)          | \
                           PIN_MODE_INPUT(GPIOB_ABS_IN)       | \
                           PIN_MODE_OUTPUT(GPIOB_INJ3))

#define VAL_GPIOB_OTYPER  (PIN_OTYPE_PUSHPULL(GPIOB_IAC_PWM)    | \
                           PIN_OTYPE_PUSHPULL(GPIOB_AUX_PWM)    | \
                           PIN_OTYPE_PUSHPULL(GPIOB_AC_REQ)      | \
                           PIN_OTYPE_PUSHPULL(GPIOB_EVAP_PWM)   | \
                           PIN_OTYPE_PUSHPULL(GPIOB_AUX_SW1)    | \
                           PIN_OTYPE_PUSHPULL(GPIOB_MIL)        | \
                           PIN_OTYPE_OPENDRAIN(GPIOB_I2C1_SCL)  | \
                           PIN_OTYPE_OPENDRAIN(GPIOB_I2C1_SDA)  | \
                           PIN_OTYPE_PUSHPULL(GPIOB_CAN1_RX)    | \
                           PIN_OTYPE_PUSHPULL(GPIOB_CAN1_TX)    | \
                           PIN_OTYPE_PUSHPULL(GPIOB_INJ1)       | \
                           PIN_OTYPE_PUSHPULL(GPIOB_INJ2)       | \
                           PIN_OTYPE_PUSHPULL(GPIOB_INJ4)       | \
                           PIN_OTYPE_PUSHPULL(GPIOB_VSS)        | \
                           PIN_OTYPE_PUSHPULL(GPIOB_ABS_IN)     | \
                           PIN_OTYPE_PUSHPULL(GPIOB_INJ3))

#define VAL_GPIOB_OSPEEDR (PIN_OSPEED_LOW(GPIOB_IAC_PWM)        | \
                           PIN_OSPEED_LOW(GPIOB_AUX_PWM)        | \
                           PIN_OSPEED_VERYLOW(GPIOB_AC_REQ)     | \
                           PIN_OSPEED_LOW(GPIOB_EVAP_PWM)       | \
                           PIN_OSPEED_VERYLOW(GPIOB_AUX_SW1)   | \
                           PIN_OSPEED_LOW(GPIOB_MIL)            | \
                           PIN_OSPEED_LOW(GPIOB_I2C1_SCL)       | \
                           PIN_OSPEED_LOW(GPIOB_I2C1_SDA)       | \
                           PIN_OSPEED_HIGH(GPIOB_CAN1_RX)       | \
                           PIN_OSPEED_HIGH(GPIOB_CAN1_TX)       | \
                           PIN_OSPEED_LOW(GPIOB_INJ1)           | \
                           PIN_OSPEED_LOW(GPIOB_INJ2)           | \
                           PIN_OSPEED_LOW(GPIOB_INJ4)           | \
                           PIN_OSPEED_VERYLOW(GPIOB_VSS)        | \
                           PIN_OSPEED_VERYLOW(GPIOB_ABS_IN)     | \
                           PIN_OSPEED_LOW(GPIOB_INJ3))

#define VAL_GPIOB_PUPDR   (PIN_PUPDR_FLOATING(GPIOB_IAC_PWM)   | \
                           PIN_PUPDR_FLOATING(GPIOB_AUX_PWM)   | \
                           PIN_PUPDR_PULLDOWN(GPIOB_AC_REQ)    | \
                           PIN_PUPDR_FLOATING(GPIOB_EVAP_PWM)  | \
                           PIN_PUPDR_PULLUP(GPIOB_AUX_SW1)     | \
                           PIN_PUPDR_FLOATING(GPIOB_MIL)       | \
                           PIN_PUPDR_FLOATING(GPIOB_I2C1_SCL)  | \
                           PIN_PUPDR_FLOATING(GPIOB_I2C1_SDA)  | \
                           PIN_PUPDR_FLOATING(GPIOB_CAN1_RX)   | \
                           PIN_PUPDR_FLOATING(GPIOB_CAN1_TX)   | \
                           PIN_PUPDR_FLOATING(GPIOB_INJ1)      | \
                           PIN_PUPDR_FLOATING(GPIOB_INJ2)      | \
                           PIN_PUPDR_FLOATING(GPIOB_INJ4)      | \
                           PIN_PUPDR_FLOATING(GPIOB_VSS)       | \
                           PIN_PUPDR_FLOATING(GPIOB_ABS_IN)    | \
                           PIN_PUPDR_FLOATING(GPIOB_INJ3))

#define VAL_GPIOB_ODR     (PIN_ODR_LOW(GPIOB_IAC_PWM)          | \
                           PIN_ODR_LOW(GPIOB_AUX_PWM)          | \
                           PIN_ODR_LOW(GPIOB_AC_REQ)           | \
                           PIN_ODR_LOW(GPIOB_EVAP_PWM)         | \
                           PIN_ODR_HIGH(GPIOB_AUX_SW1)         | \
                           PIN_ODR_LOW(GPIOB_MIL)              | \
                           PIN_ODR_HIGH(GPIOB_I2C1_SCL)        | \
                           PIN_ODR_HIGH(GPIOB_I2C1_SDA)        | \
                           PIN_ODR_HIGH(GPIOB_CAN1_RX)         | \
                           PIN_ODR_HIGH(GPIOB_CAN1_TX)         | \
                           PIN_ODR_LOW(GPIOB_INJ1)             | \
                           PIN_ODR_LOW(GPIOB_INJ2)             | \
                           PIN_ODR_LOW(GPIOB_INJ4)             | \
                           PIN_ODR_HIGH(GPIOB_VSS)             | \
                           PIN_ODR_HIGH(GPIOB_ABS_IN)          | \
                           PIN_ODR_LOW(GPIOB_INJ3))

#define VAL_GPIOB_AFRL    (PIN_AFIO_AF(GPIOB_IAC_PWM,   0U)   | \
                           PIN_AFIO_AF(GPIOB_AUX_PWM,   0U)   | \
                           PIN_AFIO_AF(GPIOB_AC_REQ,    0U)   | \
                           PIN_AFIO_AF(GPIOB_EVAP_PWM,  0U)   | \
                           PIN_AFIO_AF(GPIOB_AUX_SW1,   0U)   | \
                           PIN_AFIO_AF(GPIOB_MIL,       0U)   | \
                           PIN_AFIO_AF(GPIOB_I2C1_SCL,  4U)   | \
                           PIN_AFIO_AF(GPIOB_I2C1_SDA,  4U))

#define VAL_GPIOB_AFRH    (PIN_AFIO_AF(GPIOB_CAN1_RX,  9U)   | \
                           PIN_AFIO_AF(GPIOB_CAN1_TX,  9U)   | \
                           PIN_AFIO_AF(GPIOB_INJ1,     0U)   | \
                           PIN_AFIO_AF(GPIOB_INJ2,     0U)   | \
                           PIN_AFIO_AF(GPIOB_INJ4,     0U)   | \
                           PIN_AFIO_AF(GPIOB_VSS,      0U)   | \
                           PIN_AFIO_AF(GPIOB_ABS_IN,   0U)   | \
                           PIN_AFIO_AF(GPIOB_INJ3,     0U))

/*===========================================================================*/
/* GPIOC                                                                     */
/*                                                                           */
/* PC0  : ANALOG       (ADC1_IN10 battery voltage)                           */
/* PC1–4: OUTPUT LOW   (IGN1–4 — off at reset; TC4427/smart coil low-side)  */
/* PC5  : INPUT PULLUP (Aux switch 2)                                        */
/* PC6  : INPUT FLOATING (CRS crank sensor — Schmitt on board)               */
/* PC7  : INPUT FLOATING (CAS cam sensor — Schmitt on board)                 */
/* PC8–11: ALT AF12 PULLUP (SDIO D0–D3)                                      */
/* PC12 : ALT AF12     (SDIO CK — no pull on clock line)                     */
/* PC13 : OUTPUT LOW   (Fuel pump relay — off at reset)                      */
/* PC14 : INPUT FLOATING (OSC32_IN crystal)                                  */
/* PC15 : INPUT FLOATING (OSC32_OUT crystal)                                 */
/*===========================================================================*/
#define VAL_GPIOC_MODER   (PIN_MODE_ANALOG(GPIOC_VBATT_AIN)     | \
                           PIN_MODE_OUTPUT(GPIOC_IGN1)           | \
                           PIN_MODE_OUTPUT(GPIOC_IGN2)           | \
                           PIN_MODE_OUTPUT(GPIOC_IGN3)           | \
